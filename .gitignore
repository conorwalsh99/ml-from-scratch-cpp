# =====================================
# CMake build artifacts
# =====================================
build/                      # entire build directory
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
CTestTestfile.cmake
Testing/

# =====================================
# Compiled object files
# =====================================
*.o
*.obj
*.lo
*.slo

# =====================================
# Compiled static/dynamic libraries
# =====================================
*.a
*.lib
*.lai
*.so
*.dylib
*.dll

# =====================================
# Executables
# =====================================
*.exe
*.out
*.app
examples/knn_examples      # your example binaries
tests/*_test               # optional: if you build test binaries in tests/

# =====================================
# Debugger / profiling / IDE / OS files
# =====================================
*.dSYM
*.pdb
*.dwo
.vscode/
.idea/
.DS_Store
.env

# =====================================
# Precompiled headers
# =====================================
*.gch
*.pch

# =====================================
# GoogleTest / external libraries
# =====================================
external/googletest/build/   # ignore if you include GTest as a subdirectory
external/googletest/CMakeFiles/
external/googletest/CMakeCache.txt

